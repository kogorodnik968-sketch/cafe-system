name: CI/CD Pipeline

on:
  push:
    branches: [master, main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Build
        run: |
          cd backend
          chmod +x mvnw
          ./mvnw clean package -DskipTests -Dmaven.test.skip=true
          cd ../frontend
          npm install
          CI=false npm run build
          cd ..
          mkdir -p backend/src/main/resources/static
          cp -r frontend/build/* backend/src/main/resources/static/

  test:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Test
        run: |
          cd backend
          chmod +x mvnw
          ./mvnw test -Dmaven.test.failure.ignore=true
          cd ../frontend
          npm install
          npm test -- --watchAll=false --passWithNoTests

  deploy:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - name: Deploy to Render
        run: |
          curl -X POST "https://api.render.com/deploy/srv-d80ms41o3t8c73dtbq80?key=-fXljd_UegI"

  healthcheck:
    needs: deploy
    runs-on: ubuntu-latest
    steps:
      - name: Health Check
        run: |
          sleep 60
          curl -f https://cafe-system-rh79.onrender.com/actuator/health || exit 1